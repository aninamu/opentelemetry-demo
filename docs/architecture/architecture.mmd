%% OpenTelemetry Astronomy Shop — Architecture Diagram
%% Generated from docker-compose.yml service definitions and dependencies.
%% Edge legend:
%%   solid  = synchronous request (HTTP / gRPC)
%%   dotted = asynchronous / messaging (Kafka)
%%   dashed = telemetry (OTLP to OpenTelemetry Collector)
flowchart LR
    classDef app       fill:#4F46E5,stroke:#312E81,color:#FFFFFF,stroke-width:1px
    classDef gateway   fill:#0EA5E9,stroke:#075985,color:#FFFFFF,stroke-width:1px
    classDef infra     fill:#F59E0B,stroke:#92400E,color:#111827,stroke-width:1px
    classDef data      fill:#10B981,stroke:#065F46,color:#FFFFFF,stroke-width:1px
    classDef telemetry fill:#EF4444,stroke:#7F1D1D,color:#FFFFFF,stroke-width:1px
    classDef client    fill:#6B7280,stroke:#1F2937,color:#FFFFFF,stroke-width:1px

    User([User / Browser]):::client
    Mobile([React Native App]):::client
    Locust([Load Generator<br/><i>Python · Locust</i>]):::client

    subgraph EDGE["Edge"]
        Envoy[["frontend-proxy<br/><i>Envoy</i>"]]:::gateway
    end

    subgraph UI["UI Layer"]
        Frontend["frontend<br/><i>TypeScript · Next.js</i>"]:::app
        FlagdUI["flagd-ui<br/><i>Elixir · Phoenix</i>"]:::app
        TelemetryDocs["telemetry-docs<br/><i>MkDocs · NGINX</i>"]:::app
        ImageProvider["image-provider<br/><i>NGINX</i>"]:::app
    end

    subgraph CORE["Core Business Services"]
        Ad["ad<br/><i>Java</i>"]:::app
        Cart["cart<br/><i>.NET</i>"]:::app
        Checkout["checkout<br/><i>Go</i>"]:::app
        Currency["currency<br/><i>C++</i>"]:::app
        Email["email<br/><i>Ruby · Sinatra</i>"]:::app
        Payment["payment<br/><i>Node.js</i>"]:::app
        ProductCatalog["product-catalog<br/><i>Go</i>"]:::app
        ProductReviews["product-reviews<br/><i>Python</i>"]:::app
        Quote["quote<br/><i>PHP</i>"]:::app
        Recommendation["recommendation<br/><i>Python</i>"]:::app
        Shipping["shipping<br/><i>Rust</i>"]:::app
        Accounting["accounting<br/><i>.NET</i>"]:::app
        FraudDetection["fraud-detection<br/><i>Kotlin</i>"]:::app
        LLM["llm<br/><i>Python</i>"]:::app
    end

    subgraph DATA["Datastores &amp; Messaging"]
        Postgres[("astronomy-db<br/><i>PostgreSQL</i>")]:::data
        Valkey[("valkey-cart<br/><i>Valkey / Redis</i>")]:::data
        Kafka[/"kafka<br/><i>Apache Kafka</i>"/]:::infra
    end

    subgraph FLAGS["Feature Flags"]
        Flagd["flagd<br/><i>OpenFeature</i>"]:::infra
    end

    subgraph OBS["Observability Backend"]
        Collector["otel-collector<br/><i>OpenTelemetry Collector</i>"]:::telemetry
        Jaeger["jaeger<br/><i>Traces</i>"]:::telemetry
        Prometheus["prometheus<br/><i>Metrics</i>"]:::telemetry
        OpenSearch["opensearch<br/><i>Logs</i>"]:::telemetry
        Grafana["grafana<br/><i>Dashboards</i>"]:::telemetry
    end

    %% ----- Ingress -----
    User -->|HTTP| Envoy
    Mobile -->|HTTP| Envoy
    Locust -->|HTTP load| Envoy

    Envoy -->|/| Frontend
    Envoy -->|/feature| FlagdUI
    Envoy -->|/docs| TelemetryDocs
    Envoy -->|/grafana| Grafana
    Envoy -->|/jaeger| Jaeger
    Envoy -->|/loadgen| Locust
    Envoy -->|/images| ImageProvider
    Envoy -->|OTLP HTTP| Collector

    %% ----- Frontend -> backend services -----
    Frontend --> Ad
    Frontend --> Cart
    Frontend --> Checkout
    Frontend --> Currency
    Frontend --> ProductCatalog
    Frontend --> ProductReviews
    Frontend --> Recommendation
    Frontend --> Shipping
    Frontend --> Quote
    Frontend --> ImageProvider

    %% ----- Checkout orchestration -----
    Checkout --> Cart
    Checkout --> Currency
    Checkout --> Email
    Checkout --> Payment
    Checkout --> ProductCatalog
    Checkout --> Shipping

    %% ----- Other service-to-service -----
    Recommendation --> ProductCatalog
    ProductReviews --> ProductCatalog
    ProductReviews --> LLM
    Shipping --> Quote

    %% ----- Datastores -----
    Cart --> Valkey
    ProductCatalog --> Postgres
    ProductReviews --> Postgres
    Accounting --> Postgres

    %% ----- Kafka (async) -----
    Checkout -. order events .-> Kafka
    Kafka -. consume .-> Accounting
    Kafka -. consume .-> FraudDetection

    %% ----- Feature flags -----
    Ad -.-> Flagd
    Cart -.-> Flagd
    Checkout -.-> Flagd
    Email -.-> Flagd
    FraudDetection -.-> Flagd
    Frontend -.-> Flagd
    LLM -.-> Flagd
    Payment -.-> Flagd
    ProductCatalog -.-> Flagd
    ProductReviews -.-> Flagd
    Recommendation -.-> Flagd
    Locust -.-> Flagd
    FlagdUI -.-> Flagd

    %% ----- Telemetry (OTLP) -----
    Accounting -- OTLP --> Collector
    Ad -- OTLP --> Collector
    Cart -- OTLP --> Collector
    Checkout -- OTLP --> Collector
    Currency -- OTLP --> Collector
    Email -- OTLP --> Collector
    FraudDetection -- OTLP --> Collector
    Frontend -- OTLP --> Collector
    FlagdUI -- OTLP --> Collector
    ImageProvider -- OTLP --> Collector
    Kafka -- OTLP --> Collector
    Locust -- OTLP --> Collector
    Payment -- OTLP --> Collector
    ProductCatalog -- OTLP --> Collector
    ProductReviews -- OTLP --> Collector
    Quote -- OTLP --> Collector
    Recommendation -- OTLP --> Collector
    Shipping -- OTLP --> Collector
    Flagd -- OTLP --> Collector
    Envoy -- OTLP --> Collector

    %% ----- Collector fan-out -----
    Collector --> Jaeger
    Collector --> Prometheus
    Collector --> OpenSearch
    Grafana --> Prometheus
    Grafana --> Jaeger
    Grafana --> OpenSearch
